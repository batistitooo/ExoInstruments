bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/

*.csproj.user
!*.csproj.user.example

.DS_Store
.idea/
.claude/

# Harness virtualenvs and their dumps. Anchored rather than global: the older harnesses
# already have theirs committed.
tools/*/env/
tools/*/env
tools/*/exo_*.csv
tools/*/exo_*.bin

# Regenerated by one run of the flat-tests harness.
tools/flat-tests/case_*.fits
tools/flat-tests/bad_*.fits
tools/flat-tests/expected.csv

# Packed data products and the survey cutouts they are built from. Large (Gaia is 88 MB,
# the galaxy cache runs to gigabytes) and reproducible by rerunning the packers in tools/.
tools/*.galcat
tools/*.galimg
tools/*.starcat
tools/*.emission
tools/*.patchset
tools/*.dustmap
tools/galaxy_image_cache/
tools/shassa_cache/
tools/sn_template_cache/
tools/*.log
tools/*.err

# setup_data.py scratch space when run out of a clone.
tools/setup_env/
tools/downloads/

# KSP regenerates part icons on first load.
ExoInstruments/Parts/@thumbs/

# Release zip and its staging tree, rebuilt by `dotnet build -t:Package`.
dist/

# Guide source stays local; only the compiled PDF is tracked.
ExoInstruments-Getting-Started.tex

# Working notes kept alongside the repo, not part of it.
TECHNICAL_REFERENCE.md
TESTING.md

# Hand-staged backups before a PartTools re-export.
*.mu.bak
