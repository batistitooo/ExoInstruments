bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/

*.csproj.user
!*.csproj.user.example

.DS_Store
.idea/
.claude/

# Harness virtualenvs and their generated dumps. The older harnesses have theirs committed, which
# is why these patterns are anchored rather than global: they stop NEW ones being added (astropy
# alone is ~90 MB per env) without untracking what is already in history.
tools/*/env/
tools/*/env
tools/*/exo_*.csv
tools/*/exo_*.bin

# flat-tests writes its own FITS cases and the expected values the astropy comparison reads. Both
# are regenerated by a single run of the harness, so neither belongs in history.
tools/flat-tests/case_*.fits
tools/flat-tests/bad_*.fits
tools/flat-tests/expected.csv

# Packed data products, and the survey cutouts they are built from. These are the
# optional catalogues and maps that go in GameData/ExoInstruments/PluginData/, and
# they are large: the Gaia catalogue is 88 MB, the H-alpha map 25 MB, and the galaxy
# image cache runs to gigabytes of survey imagery. Every one of them is reproducible
# by rerunning its packer in tools/, whose README records where each pixel came from,
# so what the repository carries is the provenance rather than the bytes.
tools/*.galcat
tools/*.galimg
tools/*.starcat
tools/*.emission
tools/*.patchset
tools/*.dustmap
tools/galaxy_image_cache/
tools/*.log

# KSP regenerates the part icons in Parts/@thumbs/ on first load. They are a cache keyed to
# the models, not source, and they go stale the moment a model is re-exported.
ExoInstruments/Parts/@thumbs/
