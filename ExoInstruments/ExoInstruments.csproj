<Project Sdk="Microsoft.NET.Sdk">

    <!--
        OutputPath and the Reference HintPaths below are intentionally left unset here.
        Each developer's local KSP install path is machine-specific (and differs between
        macOS and Windows setups) — set it in a local ExoInstruments.csproj.user file,
        which is git-ignored. See ExoInstruments.csproj.user.example for the template.
    -->
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
    </PropertyGroup>

    <!--
        The one place the release version and the KSP compatibility range are written.
        Everything downstream is generated from these: the assembly version, the
        ExoInstruments.version file KSP-AVC reads, and (through that file's $vref)
        the ksp_version fields CKAN indexes. Bump ModVersion here and nowhere else.
    -->
    <PropertyGroup>
        <ModVersion>0.4.0</ModVersion>
        <KspVersionMin>1.8.0</KspVersionMin>
        <KspVersionMax>1.12.5</KspVersionMax>
        <Version>$(ModVersion)</Version>
        <AssemblyVersion>$(ModVersion).0</AssemblyVersion>
        <FileVersion>$(ModVersion).0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!--
        OutputPath points at GameData/ExoInstruments/Plugins/, so GameData/ExoInstruments/
        itself is its parent. Every deploy target below writes under this one directory,
        so resolve it once and let them all say what they mean.
    -->
    <Target Name="_ResolveModInstallDir">
        <PropertyGroup>
            <ModInstallDir>$([System.IO.Path]::GetFullPath('$(OutputPath)..'))\</ModInstallDir>
            <!-- Set here, not at the top of the file: ModInstallDir only exists once this target has run. -->
            <InstallJunk>$(ModInstallDir)**\.DS_Store;$(ModInstallDir)**\Thumbs.db;$(ModInstallDir)**\desktop.ini;$(ModInstallDir)**\*.bak;$(ModInstallDir)**\*.orig</InstallJunk>
        </PropertyGroup>
    </Target>

    <!--
        Junk that lives in the source folders but must never reach a player's GameData.
        macOS writes .DS_Store into every folder it has ever opened in Finder, and both
        of those plus a stale model.mu.bak were shipping in the release zip: 3.6 MB of
        dead weight and two files KSP would try to parse. Anything matching this is
        excluded from every copy in both directions, so it cannot leak into the release
        and cannot be pulled back out of a developer's install either.
    -->
    <PropertyGroup>
        <RepoJunk>$(ProjectDir)**\.DS_Store;$(ProjectDir)**\Thumbs.db;$(ProjectDir)**\desktop.ini;$(ProjectDir)**\*.bak;$(ProjectDir)**\*.orig</RepoJunk>
    </PropertyGroup>

    <!--
        The KSP-AVC version file, generated from the ModVersion/KspVersion properties above
        rather than checked in, so there is exactly one place a version number is written and
        nothing to drift. KSP-AVC and MiniAVC read it in game; CKAN reads it out of the release
        zip through the netkan's $vref, which is why the mod's compatibility range does not have
        to be repeated in ExoInstruments.netkan.

        URL is deliberately absent: it is KSP-AVC's remote-update-check pointer, and pointing it
        at a file that is generated (so is not in the repository to be fetched raw) would make
        every player's game report a failed check.
    -->
    <Target Name="_WriteVersionFile">
        <PropertyGroup>
            <GeneratedVersionFile>$(IntermediateOutputPath)ExoInstruments.version</GeneratedVersionFile>
        </PropertyGroup>
        <ItemGroup>
            <_VersionFileLines Include="{" />
            <_VersionFileLines Include="  &quot;NAME&quot;: &quot;ExoInstruments&quot;," />
            <_VersionFileLines Include="  &quot;DOWNLOAD&quot;: &quot;https://github.com/batistitooo/ExoInstruments/releases&quot;," />
            <_VersionFileLines Include="  &quot;VERSION&quot;: &quot;$(ModVersion)&quot;," />
            <_VersionFileLines Include="  &quot;KSP_VERSION_MIN&quot;: &quot;$(KspVersionMin)&quot;," />
            <_VersionFileLines Include="  &quot;KSP_VERSION_MAX&quot;: &quot;$(KspVersionMax)&quot;" />
            <_VersionFileLines Include="}" />
        </ItemGroup>
        <WriteLinesToFile File="$(GeneratedVersionFile)" Lines="@(_VersionFileLines)"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <!-- Same file into the developer's own install, so MiniAVC reports the real version there too. -->
    <Target Name="CopyVersionFile" AfterTargets="Build"
            DependsOnTargets="_ResolveModInstallDir;_WriteVersionFile"
            Condition="Exists('$(OutputPath)')">
        <Copy SourceFiles="$(GeneratedVersionFile)" DestinationFolder="$(ModInstallDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!--
        Mirror the repo's Textures/ folder into the install on every build so installing the
        built DLL also deploys the toolbar icon (and any other texture) to the exact path
        GameDatabase.GetTexture expects.
    -->
    <Target Name="CopyTextures" AfterTargets="Build" DependsOnTargets="_ResolveModInstallDir"
            Condition="Exists('$(OutputPath)')">
        <ItemGroup>
            <TexturesToCopy Include="$(ProjectDir)Textures\**\*.*" Exclude="$(RepoJunk)" />
        </ItemGroup>
        <Copy SourceFiles="@(TexturesToCopy)"
              DestinationFolder="$(ModInstallDir)Textures\%(RecursiveDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!--
        Same idea as CopyTextures: mirrors the repo's PluginData/ (the exoplanet and
        background-star catalogs ExoplanetCsvLoader/BackgroundStarCatalogLoader read at
        runtime) to GameData/ExoInstruments/PluginData/ on every build. Without this the
        mod builds and loads but has zero targets to observe.

        Only the two catalogues the repo carries move here. The packed sky products —
        GaiaStarCatalog.starcat, DustMap.dustmap, HalphaMap.emission, GalaxyCatalog.galcat —
        are built by tools/ straight into the install and are not in the repo, so this
        never has an opinion about them and never removes them.
    -->
    <Target Name="CopyPluginData" AfterTargets="Build" DependsOnTargets="_ResolveModInstallDir"
            Condition="Exists('$(OutputPath)')">
        <ItemGroup>
            <PluginDataToCopy Include="$(ProjectDir)PluginData\**\*.*" Exclude="$(RepoJunk)" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginDataToCopy)"
              DestinationFolder="$(ModInstallDir)PluginData\%(RecursiveDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!--
        Parts/ holds the observatory's exported .mu models and the space telescope's part
        config and textures. They are checked into the repo as binary assets, same as the
        icon in Textures/; there is no Unity/PartTools project tracked here to rebuild them
        from, so the copy in the repo is the only copy there is.

        THE COPY MUST NEVER OVERWRITE A NEWER FILE, and that is not a nicety. PartTools
        writes its .mu straight into GameData, so during modelling work the install holds
        the only copy of an export the repo has never seen. A plain mirror out of the repo
        destroys that export on the next build, silently, and the loss looks like the model
        "reverting" with nothing to point at. So each file is copied only when the side it
        is coming from is strictly the newer one: PullParts carries a fresh export back into
        the repo before the build, CopyParts pushes committed work out to the install after
        it, and neither can move a file backwards in time.

        This used to be two rsync calls with the archive and update flags, which is exactly
        the right semantics and exactly the wrong tool: Windows has no rsync, both Execs
        failed with 9009, and
        ContinueOnError turned that into a warning nobody reads. The install then sat on a
        stale model for as long as it took someone to notice. The comparison below is the
        same rule written in MSBuild, so it behaves the same on both machines and fails
        loudly if it ever cannot.

        %(ModifiedTime) on an item whose identity is the destination is empty when that
        file does not exist yet, which is the "copy it, there is nothing there" case. When
        it does exist, MSBuild's stamp format (yyyy-MM-dd HH:mm:ss.fffffff) is fixed-width,
        so an ordinal string compare is a chronological compare.

        @thumbs/ is skipped in both directions: KSP regenerates those part icons from the
        models, they go stale the moment a model is re-exported, and .gitignore keeps them
        out of the repo.

        The permanent fix is still to point PartTools at Parts/OrbitalObservatory/ directly
        and let the push be the only direction; until then this keeps both sides safe.
    -->
    <Target Name="PullParts" BeforeTargets="Build" DependsOnTargets="_ResolveModInstallDir"
            Condition="Exists('$(OutputPath)')">
        <ItemGroup>
            <_PartsInInstall Include="$(ModInstallDir)Parts\**\*.*"
                             Exclude="$(ModInstallDir)Parts\**\@thumbs\**\*.*;$(InstallJunk)" />
            <_PartPull Include="@(_PartsInInstall->'$(ProjectDir)Parts\%(RecursiveDir)%(Filename)%(Extension)')">
                <Source>%(_PartsInInstall.FullPath)</Source>
                <SourceStamp>%(_PartsInInstall.ModifiedTime)</SourceStamp>
            </_PartPull>
        </ItemGroup>
        <Copy SourceFiles="%(_PartPull.Source)"
              DestinationFiles="%(_PartPull.Identity)"
              Condition="'%(_PartPull.ModifiedTime)' == '' Or $([System.String]::CompareOrdinal('%(_PartPull.SourceStamp)', '%(_PartPull.ModifiedTime)')) &gt; 0" />
    </Target>

    <Target Name="CopyParts" AfterTargets="Build" DependsOnTargets="_ResolveModInstallDir"
            Condition="Exists('$(OutputPath)')">
        <ItemGroup>
            <_PartsInRepo Include="$(ProjectDir)Parts\**\*.*"
                          Exclude="$(ProjectDir)Parts\**\@thumbs\**\*.*;$(RepoJunk)" />
            <_PartPush Include="@(_PartsInRepo->'$(ModInstallDir)Parts\%(RecursiveDir)%(Filename)%(Extension)')">
                <Source>%(_PartsInRepo.FullPath)</Source>
                <SourceStamp>%(_PartsInRepo.ModifiedTime)</SourceStamp>
            </_PartPush>
        </ItemGroup>
        <Copy SourceFiles="%(_PartPush.Source)"
              DestinationFiles="%(_PartPush.Identity)"
              Condition="'%(_PartPush.ModifiedTime)' == '' Or $([System.String]::CompareOrdinal('%(_PartPush.SourceStamp)', '%(_PartPush.ModifiedTime)')) &gt; 0" />
    </Target>

    <!--
        `dotnet build -t:Package` builds the release a player downloads. Everything above
        deploys into one developer's own KSP install, which does nothing for anybody else;
        this target is the only thing that produces an artefact someone can be handed.

        The layout is what both audiences already expect. A player unzips and drags GameData
        onto the KSP folder — no file to move, no folder to create, no step to get wrong.
        CKAN reads ExoInstruments.netkan, which says `find: ExoInstruments, install_to:
        GameData`, and finds that directory at GameData/ExoInstruments/ inside the zip.

        Staged from the repo and from $(TargetPath), never from the local install, so a
        developer's half-finished export or hand-copied file cannot leak into a release.

        What deliberately does NOT ship: the four packed sky products. They are 138 MB of
        someone else's published survey data, every one of them optional, and README.md —
        included in the zip for this reason — has the script and the command for each. The
        mod loads and photographs the solar system without them and says in the log which
        ones it did not find.

        The staging directory is deleted first so a file dropped from the repo cannot
        survive in the zip from a previous run.
    -->
    <Target Name="Package" DependsOnTargets="Build;_WriteVersionFile">
        <PropertyGroup>
            <DistDir>$(ProjectDir)..\dist\</DistDir>
            <PackageStageDir>$(DistDir)stage\</PackageStageDir>
            <PackageModDir>$(PackageStageDir)GameData\ExoInstruments\</PackageModDir>
            <PackageZipName Condition="'$(ReleaseVersion)' == ''">ExoInstruments.zip</PackageZipName>
            <PackageZipName Condition="'$(ReleaseVersion)' != ''">ExoInstruments-$(ReleaseVersion).zip</PackageZipName>
        </PropertyGroup>

        <RemoveDir Directories="$(PackageStageDir)" />

        <ItemGroup>
            <_ShipParts Include="$(ProjectDir)Parts\**\*.*"
                        Exclude="$(ProjectDir)Parts\**\@thumbs\**\*.*;$(RepoJunk)" />
            <_ShipTextures Include="$(ProjectDir)Textures\**\*.*" Exclude="$(RepoJunk)" />
            <_ShipPluginData Include="$(ProjectDir)PluginData\**\*.*" Exclude="$(RepoJunk)" />
            <_ShipDocs Include="$(ProjectDir)..\LICENSE;$(ProjectDir)..\README.md;$(ProjectDir)..\ExoInstruments-Getting-Started.pdf" />
            <!--
                The data-file scripts have to be IN the installed mod, not just in the repository.
                CKAN installs exactly GameData/ExoInstruments/ and nothing else, so a player who
                installs through CKAN never sees the repository at all; shipping setup_data.py
                anywhere outside that directory means the README tells them to run a file they do
                not have. Inside it, `python3 GameData/ExoInstruments/tools/setup_data.py` works
                for every player by the same path, and the script finds KSP from its own location
                with nothing to configure.

                KSP's GameData scan only picks up .cfg, .dll and asset files, so .py files sitting
                here are inert as far as the game is concerned.

                Only the packers and the one entry point ship. The test harnesses, the checked-in
                virtualenvs and the download caches in tools/ are development apparatus and would
                multiply the download for no player-visible gain.
            -->
            <_ShipTools Include="$(ProjectDir)..\tools\setup_data.py;$(ProjectDir)..\tools\pack_*.py" />
        </ItemGroup>

        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageModDir)Plugins\" />
        <Copy SourceFiles="$(GeneratedVersionFile)" DestinationFolder="$(PackageModDir)" />
        <Copy SourceFiles="@(_ShipParts)" DestinationFolder="$(PackageModDir)Parts\%(RecursiveDir)" />
        <Copy SourceFiles="@(_ShipTextures)" DestinationFolder="$(PackageModDir)Textures\%(RecursiveDir)" />
        <Copy SourceFiles="@(_ShipPluginData)" DestinationFolder="$(PackageModDir)PluginData\%(RecursiveDir)" />
        <Copy SourceFiles="@(_ShipDocs)" DestinationFolder="$(PackageModDir)" />
        <Copy SourceFiles="@(_ShipTools)" DestinationFolder="$(PackageModDir)tools\" />

        <ZipDirectory SourceDirectory="$(PackageStageDir)"
                      DestinationFile="$(DistDir)$(PackageZipName)"
                      Overwrite="true" />

        <Message Importance="high" Text="Packaged $(DistDir)$(PackageZipName) — unzip over the KSP folder, or feed it to a GitHub release for CKAN." />
    </Target>
</Project>
