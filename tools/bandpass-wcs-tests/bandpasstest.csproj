<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>bandpasstest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stub.cs" />
    <Compile Include="$(Core)/SpectralCurve.cs" />
    <Compile Include="$(Core)/SystemBandpass.cs" />
    <Compile Include="$(Core)/PhotonFluxModel.cs" />
    <Compile Include="$(Core)/StellarPhotometry.cs" />
    <Compile Include="$(Core)/ReddenedResponseCache.cs" />
    <Compile Include="$(Core)/ReddenedStarSpectrum.cs" />
    <Compile Include="$(Core)/InterstellarExtinction.cs" />
    <Compile Include="$(Core)/Fitzpatrick99Table.cs" />
    <Compile Include="$(Core)/StellarColor.cs" />
    <Compile Include="$(Core)/Colorimetry.cs" />
    <Compile Include="$(Core)/CieColourMatchingTable.cs" />
    <Compile Include="$(Core)/SkyBrightnessModel.cs" />
    <Compile Include="$(Core)/AtmosphericImagingNoise.cs" />
    <Compile Include="$(Core)/AtmosphericNoise.cs" />
    <Compile Include="$(Core)/FitsWcs.cs" />
    <Compile Include="$(Core)/GnomonicProjection.cs" />
    <Compile Include="$(Core)/SkyCoordinates.cs" />
    <Compile Include="$(Core)/StarTarget.cs" />
    <Compile Include="$(Core)/InstrumentSpec.cs" />
    <!-- VisualTelescopeCatalog gained Lyot-stop and infrared-array entries, so this harness no
         longer compiles the catalogue without the two types they reference. -->
    <Compile Include="$(Core)/Coronagraph.cs" />
    <Compile Include="$(Core)/InfraredArray.cs" />
    <!-- InstrumentSpec gained a PhotometricDetector field with the CCD-equation work; without this
         the harness stopped building, which is how it was found. -->
    <Compile Include="$(Core)/PhotometricDetector.cs" />
    <Compile Include="$(Core)/DetectionResult.cs" />
    <Compile Include="$(Core)/FluxSample.cs" />
    <Compile Include="$(Core)/VisualTelescopeCatalog.cs" />
    <Compile Include="$(Core)/SpacePlatformSpec.cs" />
    <Compile Include="$(Core)/ParallelWork.cs" />
    <Compile Include="$(Core)/OpticalPsf.cs" />
    <Compile Include="$(Core)/FourierConvolution.cs" />
    <Compile Include="$(Core)/AtmosphericRefraction.cs" />
    <Compile Include="$(Core)/RadialPsfProfile.cs" />
    <Compile Include="$(Core)/DirectImagingSimulator.cs" />
    <Compile Include="$(Core)/DirectImagingResult.cs" />
    <Compile Include="$(Core)/PupilDiffraction.cs" />
    <Compile Include="$(Core)/FilterCurves.cs" />
    <Compile Include="$(Core)/GaiaPhotometry.cs" />
    <Compile Include="$(Core)/RenderedStarCatalog.cs" />
    <Compile Include="$(Core)/StarFieldRenderer.cs" />
  </ItemGroup>
</Project>
