<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>loadprof</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The mod targets net472, so Core must compile as C# 7.3. -->
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <Core Condition="'$(Core)' == ''">../../ExoInstruments/Core</Core>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LoadProfile.cs" />
    <Compile Include="$(Core)/Healpix.cs" />
    <Compile Include="$(Core)/Float16.cs" />
    <Compile Include="$(Core)/ParallelWork.cs" />
    <Compile Include="$(Core)/EmissionMap.cs" />
    <Compile Include="$(Core)/EmissionPatchSet.cs" />
    <Compile Include="$(Core)/GalacticCoordinates.cs" />
    <Compile Include="$(Core)/SexagesimalCoordinates.cs" />
    <Compile Include="$(Core)/StarTarget.cs" />
    <Compile Include="$(Core)/StarNames.cs" />
    <Compile Include="$(Core)/StellarColor.cs" />
    <Compile Include="$(Core)/Colorimetry.cs" />
    <Compile Include="$(Core)/CieColourMatchingTable.cs" />
    <Compile Include="$(Core)/SpectralCurve.cs" />
    <Compile Include="$(Core)/ExoplanetCSVLoader.cs" />
    <Compile Include="$(Core)/BackgroundStarCatalogLoader.cs" />
    <Compile Include="$(Core)/StarCatalogMerger.cs" />
    <Compile Include="$(Core)/CatalogDensityThinner.cs" />
  </ItemGroup>
</Project>
