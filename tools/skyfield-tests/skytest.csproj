    <Compile Include="$(Core)/StellarActivity.cs" />
    <Compile Include="$(Core)/MoonlightPollution.cs" />
    <Compile Include="$(Core)/ObservingForecast.cs" />
    <Compile Include="$(Core)/HabitableZoneCalculator.cs" />
    <Compile Include="$(Core)/ReddenedResponseCache.cs" />
    <Compile Include="$(Core)/ReddenedStarSpectrum.cs" />
    <Compile Include="$(Core)/InterstellarExtinction.cs" />
