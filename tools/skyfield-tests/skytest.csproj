    <Compile Include="$(Core)/TransitPhotometry.cs" />
    <Compile Include="$(Core)/TransitTimingVariations.cs" />
    <Compile Include="$(Core)/TransitDetector.cs" />
    <Compile Include="$(Core)/StellarPhotometry.cs" />
    <Compile Include="$(Core)/SkyBrightnessModel.cs" />
    <Compile Include="$(Core)/SkyCoordinates.cs" />
    <Compile Include="$(Core)/PhotonFluxModel.cs" />
    <Compile Include="$(Core)/StellarColor.cs" />
    <Compile Include="$(Core)/Colorimetry.cs" />
    <Compile Include="$(Core)/CieColourMatchingTable.cs" />
    <Compile Include="$(Core)/StarTarget.cs" />
    <Compile Include="$(Core)/AtmosphericImagingNoise.cs" />
    <Compile Include="$(Core)/AtmosphericNoise.cs" /><Compile Include="$(Core)/InstrumentSpec.cs" /><Compile Include="$(Core)/DetectionResult.cs" /><Compile Include="$(Core)/FluxSample.cs" />
    <Compile Include="$(Core)/SystemBandpass.cs" />
    <Compile Include="$(Core)/SpectralCurve.cs" />
