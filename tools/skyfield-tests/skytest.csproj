<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>skytest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="Stub.cs" />
    <Compile Include="$(Core)/GnomonicProjection.cs" />
    <Compile Include="$(Core)/RenderedStarCatalog.cs" />
    <Compile Include="$(Core)/StarFieldRenderer.cs" />
    <Compile Include="$(Core)/StellarPhotometry.cs" />
    <Compile Include="$(Core)/SkyBrightnessModel.cs" />
    <Compile Include="$(Core)/SkyCoordinates.cs" />
    <Compile Include="$(Core)/PhotonFluxModel.cs" />
    <Compile Include="$(Core)/StellarColor.cs" />
    <Compile Include="$(Core)/StarTarget.cs" />
    <Compile Include="$(Core)/AtmosphericImagingNoise.cs" />
    <Compile Include="$(Core)/AtmosphericNoise.cs" /><Compile Include="$(Core)/InstrumentSpec.cs" /><Compile Include="$(Core)/DetectionResult.cs" /><Compile Include="$(Core)/FluxSample.cs" />
  </ItemGroup>
</Project>
