<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>galaxy</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DumpGalaxy.cs" />
    <!-- The real shipped Core. -->
    <Compile Include="$(Core)/SersicProfile.cs" />
    <Compile Include="$(Core)/GalaxyRenderer.cs" />
    <Compile Include="$(Core)/GalaxyCatalog.cs" />
  </ItemGroup>
</Project>
